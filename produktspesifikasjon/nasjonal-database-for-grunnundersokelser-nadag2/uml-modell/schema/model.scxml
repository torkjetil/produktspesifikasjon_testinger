       <sc:id>C67_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring ved oppnådd boredybde i berg &lt;engelsk&gt;code for termination of boring after assumed depth in rock&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
