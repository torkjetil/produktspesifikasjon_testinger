    <sc:Package>
     <sc:name>FeatureTypes</sc:name>
     <sc:id>P4</sc:id>
     <sc:classes>
      <sc:Class>
       <sc:name>Trykksondering</sc:name>
       <sc:id>C1</sc:id>
       <sc:stereotypes>
        <sc:Stereotype>featuretype</sc:Stereotype>
       </sc:stereotypes>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>penetrasjon av en trykksonde på enden av en serie med sylindriske trykksonderingsstenger ned i grunnen med konstant hastighet, brukes for å bestemme lagdeling og jordart i løsmasser, samt mekaniske egenskaper for jorden&lt;engelsk&gt;penetration of a probe at the end of a series with cylindrical rods into the ground at the constant rate of penetration, used to determine stratification and soil type, together with mechanical properties of the soil&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C49</sc:SupertypeId>
       </sc:supertypes>
       <sc:properties>
        <sc:Property>
         <sc:name>alpha</sc:name>
         <sc:id>C1_1</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>arealforhold for trykksonde for korreksjon av målt spissmotstand for poretrykkseffekter&lt;engelsk&gt;area ratio for CPT probe for correction of measured cone resistance for pore pressure effects&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>ALPHA</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>1</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>atmosferiskTrykkKorreksjon</sc:name>
         <sc:id>C1_2</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>&lt;engelsk&gt;Gets or sets the atmospheric pressure correction [MPa].
@value The atmospheric pressure correction.&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>ATMOSFERISKTRYKKKORREKSJON</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>2</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>cptKorreksjonsFaktor</sc:name>
         <sc:id>C1_3</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>øvrige faktorer for korreksjon av trykksonderingsdata, for eksempel korreksjon av målt sidefriksjon&lt;engelsk&gt;other factors for correction of CPT data, for example correction of measured sleeve friction&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>CPTKORREKSJONSFAKTOR</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>3</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>filterType</sc:name>
         <sc:id>C1_4</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>type filter for måling av poretrykk (porøst filter, ferdigmettet, spaltefilter)&lt;engelsk&gt;type of filter for measurement of pore pressure (porous filter, pre-saturated filter, slot filter)&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>FILTERTYPE</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>4</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>hylseRadieKorreksjon</sc:name>
         <sc:id>C1_5</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>&lt;engelsk&gt;Gets or sets the sleeve distance correction [m].
@value The sleeve distance correction.&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>HYLSERADIEKORREKSJON</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>5</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>initiellSpissmotstand</sc:name>
         <sc:id>C1_6</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>referanseverdi for spissmotstand ved start av måling (eksempel ved start dissipasjonstest) [MPa] &lt;engelsk&gt;reference value cone resistance at the start of the test (e.g. at the start of a dissipation test)&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>INITIELLSPISSMOTSTAND</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>6</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>metningsMedium</sc:name>
         <sc:id>C1_7</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>medium som benyttes for metting av målesystem for poretrykk&lt;engelsk&gt;medium used for saturation of measuring system for pore pressure&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>METNINGSMEDIUM</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>7</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>nedpressingsKapasitet</sc:name>
         <sc:id>C1_8</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>kapasitet for anvendt nedpressingsutstyr [kN] &lt;engelsk&gt;capacity for applied thrust machine&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>NEDPRESSINGSKAPASITET</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>8</sc:sequenceNumber>
         <sc:typeId>C55</sc:typeId>
         <sc:typeName>NedpressingsKapasitet</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>nedpressningsHastighet</sc:name>
         <sc:id>C1_9</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>nedpressingshastighet ved penetrasjon av trykksonderingsstenger (standard er 20 mm/s ± 5 mm/s) [mm/s] &lt;engelsk&gt;rate of penetration for rod system (standard is 20 mm/s ± 5 mm/s)&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>NEDPRESSNINGSHASTIGHET</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>9</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>nullpunktsKorreksjon</sc:name>
         <sc:id>C1_10</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>korreksjon for registrert nullpunktsavvik før og etter sondering &lt;engelsk&gt;correction for recorded zero load drift before and after sounding&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>NULLPUNKTSKORREKSJON</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>10</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>rørKappeKorreksjonsFaktor</sc:name>
         <sc:id>C1_11</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>korreksjonsfaktor for bruk av friksjonsreduksjonsring &lt;engelsk&gt;correction factor for use of friction reducer&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>RØRKAPPEKORREKSJONSFAKTOR</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>11</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>sidefriksjonKorreksjon</sc:name>
         <sc:id>C1_12</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>korreksjon av målt sidefriksjon på grunn av poretrykkseffekter&lt;engelsk&gt;correction of measured sleeve friction due to pore pressure effects&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SIDEFRIKSJONKORREKSJON</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>12</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>sondeIdentifikasjon</sc:name>
         <sc:id>C1_13</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>identifikasjon av trykksonde ved hjelp av ID-nummer &lt;engelsk&gt;identification of probe by an ID-number&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SONDEIDENTIFIKASJON</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>13</sc:sequenceNumber>
         <sc:typeName>CharacterString</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>sondeKalibreringDato</sc:name>
         <sc:id>C1_14</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>dato for kalibrering av trykksonde, oppgis på kalibreringssertifikat&lt;engelsk&gt;date for calibration of probe, given on the calibration certificate&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SONDEKALIBRERINGDATO</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>14</sc:sequenceNumber>
         <sc:typeName>Date</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>sondeKvalitetKlasse</sc:name>
         <sc:id>C1_15</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>kvalitetsklasse for målenøyaktighet for en trykksonde ved gjennomføring av anbefalt prøvingsprosedyre &lt;engelsk&gt;application class for test accuracy for test performance according to a recommended test procedure&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SONDEKVALITETSKLASSE</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>15</sc:sequenceNumber>
         <sc:typeId>C56</sc:typeId>
         <sc:typeName>SondeKvalitetsKlasse</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>spissKorreksjonFaktor</sc:name>
         <sc:id>C1_16</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>korreksjonsfaktor for trykksonde ved korreksjon av målt spissmotstand for poretrykkseffekter&lt;engelsk&gt;correction factor for measured cone resistance for pore pressure effects&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SPISSKORREKSJONFAKTOR</sc:Value>
           </sc:values>
          </sc:TaggedValue>
         </sc:taggedValues>
         <sc:cardinality>0..1</sc:cardinality>
         <sc:sequenceNumber>16</sc:sequenceNumber>
         <sc:typeName>Real</sc:typeName>
        </sc:Property>
        <sc:Property>
         <sc:name>spissType</sc:name>
         <sc:id>C1_17</sc:id>
         <sc:descriptors>
          <sc:documentation>
           <sc:descriptorValues>
            <sc:DescriptorValue>type trykksonde, avhengig av størrelse og instrumentering&lt;engelsk&gt;type of probe, depending on size and instrumentation&lt;/engelsk&gt;</sc:DescriptorValue>
           </sc:descriptorValues>
          </sc:documentation>
         </sc:descriptors>
         <sc:taggedValues>
          <sc:TaggedValue>
           <sc:name>SOSI_navn</sc:name>
           <sc:values>
            <sc:Value>SPISSTYPE</sc:Value>
           </sc:values>
