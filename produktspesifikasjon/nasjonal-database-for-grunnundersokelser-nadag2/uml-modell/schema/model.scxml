       <sc:id>C67_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring ved oppnådd boredybde i berg større enn 3 m &lt;engelsk&gt;code for termination of boring after assumed depth in rock greater than 3 m&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
