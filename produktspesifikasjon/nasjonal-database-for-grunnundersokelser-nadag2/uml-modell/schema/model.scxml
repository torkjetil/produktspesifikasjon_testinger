       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring i antatt berg &lt;engelsk&gt;code for termination of boring in presumed rock&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>AntattSteinBlokk</sc:name>
       <sc:id>C67_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring i antatt stein eller blokk &lt;engelsk&gt;code for termination of boring in presumed stone or block&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>BruddBorstangSpiss</sc:name>
       <sc:id>C67_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring ved brudd i borstang eller borspiss &lt;engelsk&gt;code for termination of boring due to failure of drill rod or drill bit&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
