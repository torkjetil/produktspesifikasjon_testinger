      </sc:Property>
      <sc:Property>
       <sc:name>eksternNavnerom</sc:name>
       <sc:id>C52_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navnerom som identifiserer datakilden/leverandør til objektet</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>EKSTERNNAVNEROM</sc:Value>
         </sc:values>
