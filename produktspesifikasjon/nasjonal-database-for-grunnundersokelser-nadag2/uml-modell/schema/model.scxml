       <sc:name>eksternId</sc:name>
       <sc:id>C52_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>lokal identifikator, tildelt av ekstern leverendør.
Det er data leverendørens ansvar å sørge for at denne eksterne identifikatoren er unik innenfor navnerommet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>EKSTERNID</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>eksternLeveringDato</sc:name>
       <sc:id>C52_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Når objektet ble levert til database (Nadag)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
