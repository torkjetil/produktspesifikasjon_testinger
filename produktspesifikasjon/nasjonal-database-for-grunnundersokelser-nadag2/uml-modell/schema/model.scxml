       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>geografisk punkt hvor det er utført feltforsøk, prøvetaking, måling av poretrykk osv. med tilhørende observasjoner &lt;engelsk&gt;geographical location where field tests, sampling, pore pressure measurements etc. with corresponding observations have been carried out&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:supertypes>
        <sc:SupertypeId>C42</sc:SupertypeId>
       </sc:supertypes>
