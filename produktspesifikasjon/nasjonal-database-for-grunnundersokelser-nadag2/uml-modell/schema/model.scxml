       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>kode for avslutning av boring ved oppnådd boredybde i berg større enn 3 m og borestøv har blitt analysert &lt;engelsk&gt;code for termination of boring after assumed depth in rock greater than 3 m and the drill cuttings have been analysed&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
