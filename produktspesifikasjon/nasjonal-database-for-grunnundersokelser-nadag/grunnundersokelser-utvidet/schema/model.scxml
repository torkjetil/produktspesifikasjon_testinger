   <sc:classes>
    <sc:Class>
     <sc:name>Identifikasjon</sc:name>
     <sc:id>C1</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>lokalId</sc:name>
       <sc:id>C1_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lokal identifikator, tildelt av dataleverendør/dataforvalter. Den lokale identifikatoren er unik innenfor navnerommet, ingen andre objekter har samme identifikator.&lt;br/&gt;NOTE: Det er data leverendørens ansvar å sørge for at denne lokale identifikatoren er unik innenfor navnerommet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>navnerom</sc:name>
       <sc:id>C1_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navnerom som unikt identifiserer datakilden til objektet, starter med to bokstavs kode jfr ISO 3166. Benytter understreking  ("_") dersom data produsenten ikke er assosiert med bare et land.
&lt;br/&gt;NOTE 1 : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og vil registreres i "INSPIRE external  Object Identifier Namespaces Register"&lt;br/&gt;Eksempel: NO for Norge.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>versjonId</sc:name>
       <sc:id>C1_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Identifikasjon av en spesiell versjon av et geografisk objekt (instans), maksimum lengde på 25 karakterers. Dersom spesifikasjonen av et geografisk objekt med en identifikasjon inkludererer livsløpssyklusinformasjon, benyttes denne versjonId for å skille mellom ulike versjoner av samme objekt. versjonId er en unik  identifikasjon av versjonen. &lt;br/&gt;NOTE Maksimum lengde er valgt for å tillate tidsregistrering i henhold til  ISO 8601, slik som  "2007-02-12T12:12:12+05:30" som versjonId.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>PosisjonskvalitetNADAG</sc:name>
     <sc:id>C2</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>målemetode</sc:name>
       <sc:id>C2_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Metode for måling i grunnriss (x,y), og høyde (z) når metoden er den samme som ved måling i grunnriss</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeId>C7</sc:typeId>
       <sc:typeName>Målemetode</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>målemetodeHøyde</sc:name>
       <sc:id>C2_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Metode for å måle høyden</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeId>C8</sc:typeId>
       <sc:typeName>MålemetodeHøyde</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>nøyaktighet</sc:name>
       <sc:id>C2_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Punktstandardavviket i grunnriss for punkter samt tverravvik for linjer&lt;br/&gt;Merknad:&lt;br/&gt;Oppgitt i [cm]</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>nøyaktighetHøyde</sc:name>
       <sc:id>C2_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Nøyaktighet for høyden i [cm]</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>BorlengdeTilBerg</sc:name>
     <sc:id>C3</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>borlengdeKvalitet</sc:name>
       <sc:id>C3_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Beskriver om dybden til berg er antatt eller påvist med en sikker metode&lt;br/&gt;&lt;engelsk style="font-style:italic;font-size:smaller"&gt; &lt;br/&gt;Defines the quality of the depth information either assumed or confirmed by a secure method&lt;br/&gt;&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeId>C9</sc:typeId>
       <sc:typeName>BorlengdeKvalitet</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>borlengdeTilBerg</sc:name>
       <sc:id>C3_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dybde til fjell som ikke er målt men basert på tolkning [m]&lt;br/&gt;&lt;engelsk style="font-style:italic;font-size:smaller"&gt;&lt;br/&gt;Depth to bedrock based on interpretation
&lt;/engelsk&gt;</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>EksternIdentifikasjon</sc:name>
